{
  "id": "competencyCreate",
  "endPoints": [
    {
      "name": "launch_saveCompetencyOrch",
      "baseUrlType": "workday-orch",
      "url": "competencyCreateUpdate/launch",
      "deferred": true,
      "authType": "sso",
      "httpMethod": "POST",
      "onSend": "<%
          var body = {
            'createOrUpdate': 'Create',
            'workdayID': '',
            'competencyName': compName.value,
            'description': regex:replace(compDescription.value, '<[^>]+>', ''),
            'usedForTalentMatrix': compUsedForTalentMatrix.value == true ? 'true' : 'false',
            'inactive': compInactive.value == true ? 'true' : 'false',
            'effectiveDate': !empty compEffectiveDate.value ? date:format(compEffectiveDate.value, 'yyyy-MM-dd') : '',
            'categoryWIDs': !empty compCategory.value ? compCategory.value : [],
            'trainingType': !empty trainingType.value ? trainingType.value : '',
            'trainingFreq': !empty trainingFreq.value ? trainingFreq.value : '',
            'manufacturer': !empty manufacturer.value ? manufacturer.value : '',
            'equipmentName': !empty equipmentName.value ? equipmentName.value : '',
            'modelNumber': !empty modelNumber.value ? modelNumber.value : ''
          };
          console.info('launch_saveCompetencyOrch (Create)==>' + json:asJSON(body));
          return body;
        %>",
      "_onSend": "<%
        var body = {
          'createOrUpdate': 'Create',
          'workdayID': '',
          'competencyName': compName.value,
          'description': regex:replace(compDescription.value, '<[^>]+>', ''),
          'usedForTalentMatrix': compUsedForTalentMatrix.value == true ? 'true' : 'false',
          'inactive': compInactive.value == true ? 'true' : 'false',
          'effectiveDate': !empty compEffectiveDate.value ? date:format(compEffectiveDate.value, 'yyyy-MM-dd') : '',
          'categoryWIDs': !empty compCategory.value ? compCategory.value : []
        };
        console.info('launch_saveCompetencyOrch (Create)==>' + json:asJSON(body));
        return body;
      %>",
      
      "failOnStatusCodes": [
        { "code": "400" },
        { "code": "403" },
        { "code": "500" }
      ]
    },
    {
      "name": "lookupCompetencyByName",
      "baseUrlType": "workday-wql",
      "authType": "sso",
      "deferred": true,
      "url": "<%
        const name = compName.value;
        const query = 'SELECT workdayID, competency, competencyName FROM allCompetencies WHERE competencyName = \"' + name + '\"';
        return query.urlEncode();
      %>"
    }
  ],

  "presentation": {
    "pageType": "EDIT",
    "title": {
      "type": "title",
      "label": "Create Competency"
    },
    "body": {
      "type": "section",
      "children": [
        {
          "type": "section",
          "label": "Competency Details",
          "children": [
            {
              "type": "text",
              "id": "compId",
              "label": "Competency ID",
              "enabled": false,
              "value": "<% '(generated on save)' %>"
            },
            {
              "type": "text",
              "id": "compName",
              "label": "Name",
              "required": true,
              "value": "<% '' %>"
            },
            {
              "type": "instanceList",
              "id": "compCategory",
              "label": "Category",
              "multiSelect": true,
              "values": "<% [
                {'id': 'a1c970bd7c6945388bde0693272775ca', 'descriptor': 'Ability'},
                {'id': 'f21c0c547627422f95f6a8cb59d49fb7', 'descriptor': 'Behavior'},
                {'id': '61aa27fd07051000cff37d25d3990000', 'descriptor': 'Core Hospital'},
                {'id': '61aa27fd07051000cff37dbf8fa30000', 'descriptor': 'Equipment'},
                {'id': '61aa27fd07051000cff37d25d3990001', 'descriptor': 'Job Specific'},
                {'id': 'f84bcb568f4648cfadf78649d425591c', 'descriptor': 'Knowledge'},
                {'id': '61aa27fd07051000cff37d25d3990002', 'descriptor': 'Location Specific'},
                {'id': '61aa27fd07051000cff37c8c096a0000', 'descriptor': 'Manager Added'},
                {'id': '6729e2fa56fd4f25b5871ae1726ddaa5', 'descriptor': 'Skill'}
              ] %>",
              "onChange": "<%
                var picked = !empty compCategory.value ? compCategory.value : [];
                var equipmentWID = '61aa27fd07051000cff37dbf8fa30000';
                var jobSpecWID = '61aa27fd07051000cff37d25d3990001';
                var locSpecWID = '61aa27fd07051000cff37d25d3990002';

                var hasEquipment = picked.contains(equipmentWID);
                var hasJobSpec = picked.contains(jobSpecWID);
                var hasLocSpec = picked.contains(locSpecWID);
                var hasTrainingCategory = hasEquipment || hasJobSpec || hasLocSpec;

                trainingType.setVisible(hasTrainingCategory);
                trainingFreq.setVisible(hasTrainingCategory);
                manufacturer.setVisible(hasEquipment);
                equipmentName.setVisible(hasEquipment);
                modelNumber.setVisible(hasEquipment);
              %>"
            },
            {
              "type": "checkBox",
              "id": "compUsedForTalentMatrix",
              "label": "Used For Talent Matrix",
              "value": "<% false %>"
            },
            {
              "type": "checkBox",
              "id": "compInactive",
              "label": "Inactive",
              "value": "<% false %>"
            },
            {
              "type": "date",
              "id": "compEffectiveDate",
              "label": "Effective Date",
              "required": true,
              "value": "<% date:getTodaysDate(date:getDateTimeZone(userTimeZone)) %>"
            },
            {
              "type": "richText",
              "id": "compDescription",
              "label": "Competency Description",
              "value": "<% '' %>"
            }
          ]
        },
        {
          "type": "fieldSet",
          "id": "customFieldsSet",
          "label": "Additional Details (Custom)",
          "children": [
            {
              "type": "text",
              "id": "trainingType",
              "label": "Type of Training",
              "value": "<% '' %>",
              "visible": false
            },
            {
              "type": "text",
              "id": "trainingFreq",
              "label": "Training Frequency",
              "value": "<% '' %>",
              "visible": false
            },
            {
              "type": "text",
              "id": "manufacturer",
              "label": "Manufacturer",
              "value": "<% '' %>",
              "visible": false
            },
            {
              "type": "text",
              "id": "equipmentName",
              "label": "Equipment Name",
              "value": "<% '' %>",
              "visible": false
            },
            {
              "type": "text",
              "id": "modelNumber",
              "label": "Model Number or Series",
              "value": "<% '' %>",
              "visible": false
            }
          ]
        },
        {
          "type": "section",
          "children": [
            {
              "type": "pageActionButton",
              "id": "btnCreate",
              "label": "Create Competency",
              "onClick": "<%
                      console.info('Button clicked - starting Create flow');

                      var soapResp = launch_saveCompetencyOrch.invoke();
                      console.info('SOAP response: ' + json:asJSON(soapResp));

                      var lookupResp = lookupCompetencyByName.invoke();
                      console.info('Lookup response: ' + json:asJSON(lookupResp));

                      if (!empty lookupResp && !empty lookupResp.data && !empty lookupResp.data[0]) {
                        var newWID = lookupResp.data[0].workdayID;
                        compId.value = newWID;
                        console.info('Found new WID: ' + newWID);
                        createStatus.value = 'Competency created. WID: ' + newWID;
                      } else {
                        createStatus.value = 'Workday create succeeded but WID lookup failed - check console';
                      }
                    %>",
              "_onClick": "<%
                console.info('Button clicked - starting Create flow');

                var soapResp = launch_saveCompetencyOrch.invoke();
                console.info('SOAP response: ' + json:asJSON(soapResp));

                var lookupResp = lookupCompetencyByName.invoke();
                console.info('Lookup response: ' + json:asJSON(lookupResp));

                var newWID = '';
                var lookupSucceeded = false;

                if (!empty lookupResp && !empty lookupResp.data && !empty lookupResp.data[0]) {
                  newWID = lookupResp.data[0].workdayID;
                  compId.value = newWID;
                  lookupSucceeded = true;
                  console.info('Found new WID: ' + newWID);
                }

                if (!lookupSucceeded) {
                  createStatus.value = 'Created in Workday but WID lookup failed - check console';
                } else {
                  var hasExtendedData = !empty trainingType.value
                                     || !empty trainingFreq.value
                                     || !empty manufacturer.value
                                     || !empty equipmentName.value
                                     || !empty modelNumber.value;

                  if (!hasExtendedData) {
                    createStatus.value = 'Competency created in Workday (WID: ' + newWID + '). No extended data to save.';
                  } else {
                    var boResp = saveCompetencyExtended.invoke();
                    console.info('BO response: ' + json:asJSON(boResp));
                    createStatus.value = 'Competency created in Workday AND extended data saved. WID: ' + newWID;
                  }
                }
              %>"
            },
            {
              "type": "text",
              "id": "createStatus",
              "label": "Create status",
              "enabled": false,
              "value": "<% '' %>"
            }
          ]
        }
      ]
    }
  }
}