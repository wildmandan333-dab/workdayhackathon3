{
  "id": "competencyBackup",
  "endPoints": [
    {
      "name": "launch_saveCompetencyOrch",
      "baseUrlType": "workday-orch",
      "url": "competencyCreateUpdate/launch",
      "deferred": true,
      "authType": "sso",
      "httpMethod": "POST",
      "onSend": "<%
        var body = {
          'createOrUpdate': 'Create',
          'workdayID': '',
          'competencyName': compName.value,
          'description': regex:replace(compDescription.value, '<[^>]+>', ''),
          'usedForTalentMatrix': compUsedForTalentMatrix.value == true ? 'true' : 'false',
          'inactive': compInactive.value == true ? 'true' : 'false',
          'effectiveDate': compEffectiveDate.value,
          'categoryWIDs': !empty compCategory.value ? compCategory.value : []
        };
        console.info('launch_saveCompetencyOrch (Create)==>' + json:asJSON(body));
        return body;
      %>",
      "failOnStatusCodes": [
        { "code": "400" },
        { "code": "403" },
        { "code": "500" }
      ]
    }
  ],

  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "saveCompetencyExtended",
        "baseUrlType": "app",
        "url": "competencyExtendeds",
        "httpMethod": "POST",
        "authType": "sso",
        "onSend": "<%
          self.data.compWorkdayID = 'TEST-WID-12345';
          console.info('saveCompetencyExtended payload: ' + json:asJSON(self.data));
          return self.data;
        %>"
      }
    ],
    "responseErrorDetail": {
      "errorSummary": "<% error %>",
      "errors": "<% errors.map(item => { item.error }) %>"
    }
  },

  "presentation": {
    "pageType": "edit",
    "title": {
      "type": "title",
      "label": "Create Competency"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "text",
          "id": "compId",
          "label": "Competency ID",
          "enabled": false,
          "value": "<% '(generated on save)' %>"
        },
        {
          "type": "text",
          "id": "compName",
          "label": "Name",
          "required": true,
          "value": "<% '' %>"
        },
        {
          "type": "instanceList",
          "id": "compCategory",
          "label": "Category",
          "multiSelect": true,
          "values": "<% [
            {'id': 'a1c970bd7c6945388bde0693272775ca', 'descriptor': 'Ability'},
            {'id': 'f21c0c547627422f95f6a8cb59d49fb7', 'descriptor': 'Behavior'},
            {'id': '61aa27fd07051000cff37d25d3990000', 'descriptor': 'Core Hospital'},
            {'id': '61aa27fd07051000cff37dbf8fa30000', 'descriptor': 'Equipment'},
            {'id': '61aa27fd07051000cff37d25d3990001', 'descriptor': 'Job Specific'},
            {'id': 'f84bcb568f4648cfadf78649d425591c', 'descriptor': 'Knowledge'},
            {'id': '61aa27fd07051000cff37d25d3990002', 'descriptor': 'Location Specific'},
            {'id': '61aa27fd07051000cff37c8c096a0000', 'descriptor': 'Manager Added'},
            {'id': '6729e2fa56fd4f25b5871ae1726ddaa5', 'descriptor': 'Skill'}
          ] %>",
          "onChange": "<%
            var picked = !empty compCategory.value ? compCategory.value : [];
            var equipmentWID = '61aa27fd07051000cff37dbf8fa30000';
            var jobSpecWID = '61aa27fd07051000cff37d25d3990001';
            var locSpecWID = '61aa27fd07051000cff37d25d3990002';

            var hasEquipment = picked.contains(equipmentWID);
            var hasJobSpec = picked.contains(jobSpecWID);
            var hasLocSpec = picked.contains(locSpecWID);
            var hasTrainingCategory = hasEquipment || hasJobSpec || hasLocSpec;

            trainingType.setVisible(hasTrainingCategory);
            trainingFreq.setVisible(hasTrainingCategory);
            manufacturer.setVisible(hasEquipment);
            equipmentName.setVisible(hasEquipment);
            modelNumber.setVisible(hasEquipment);
          %>"
        },
        {
          "type": "checkBox",
          "id": "compUsedForTalentMatrix",
          "label": "Used For Talent Matrix",
          "value": "<% false %>"
        },
        {
          "type": "checkBox",
          "id": "compInactive",
          "label": "Inactive",
          "value": "<% false %>"
        },
        {
          "type": "date",
          "id": "compEffectiveDate",
          "label": "Effective Date",
          "required": true,
          "value": "<% date:getTodaysDate(date:getDateTimeZone(userTimeZone)) %>"
        },
        {
          "type": "richText",
          "id": "compDescription",
          "label": "Competency Description",
          "value": "<% '' %>"
        },
        {
          "type": "text",
          "id": "trainingType",
          "label": "Type of Training",
          "value": "<% '' %>",
          "valueOutBinding": "saveCompetencyExtended.trainingType"
        },
        {
          "type": "text",
          "id": "trainingFreq",
          "label": "Training Frequency",
          "value": "<% '' %>",
          "valueOutBinding": "saveCompetencyExtended.trainingFreq"
        },
        {
          "type": "text",
          "id": "manufacturer",
          "label": "Manufacturer",
          "value": "<% '' %>",
          "valueOutBinding": "saveCompetencyExtended.manufacturer"
        },
        {
          "type": "text",
          "id": "equipmentName",
          "label": "Equipment Name",
          "value": "<% '' %>",
          "valueOutBinding": "saveCompetencyExtended.equipmentName"
        },
        {
          "type": "text",
          "id": "modelNumber",
          "label": "Model Number or Series",
          "value": "<% '' %>",
          "valueOutBinding": "saveCompetencyExtended.modelNumber"
        }
      ]
    }
  }
}